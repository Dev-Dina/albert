APP_ENV=local
APP_NAME=albert
LOG_LEVEL=INFO
BACKEND_PORT=8000
ADMIN_PORT=8501

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/albert
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=albert

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT=secret

JWT_SECRET=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MODELSERVER_URL=http://modelserver:8020
GUARDRAILS_URL=http://guardrails:8010
SERVICE_AUTH_TOKEN=dev-service-token

# LLM provider config.
# GEMINI_MODEL is the backend agent/RAG runtime model (Owner B). It is NOT the
# Owner C classifier baseline: that baseline is recorded separately as
# gemini-2.5-flash-lite (precomputed in training artifacts + MODEL_CARD.md), is not
# read from this var, and is never called in CI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenTelemetry + Jaeger tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=albert-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=otlp
JAEGER_UI_BASE_URL=http://localhost:16686
JAEGER_QUERY_BASE_URL=http://localhost:16686

# Widget auth + rate limit
# Defaults are conservative dev values; tune per environment, never hard-code.
WIDGET_SESSION_TTL_SECONDS=900
WIDGET_CLOCK_SKEW_SECONDS=60
WIDGET_RATE_LIMIT_PER_IP_PER_MIN=30
WIDGET_RATE_LIMIT_PER_TENANT_PER_MIN=120
WIDGET_LOADER_URL=http://localhost:8000/widget.js