APP_ENV=local
APP_NAME=albert
LOG_LEVEL=INFO
BACKEND_PORT=8000
ADMIN_PORT=8501
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/albert
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=albert
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
JWT_SECRET=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MODELSERVER_URL=http://modelserver:8020
GUARDRAILS_URL=http://guardrails:8010
SERVICE_AUTH_TOKEN=dev-service-token
OTEL_ENABLED=false
OTEL_SERVICE_NAME=albert-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=otlp
