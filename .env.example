APP_ENV=local
APP_NAME=albert
LOG_LEVEL=INFO
BACKEND_PORT=8000
ADMIN_PORT=8501

# Runtime app DB role: a dedicated NON-superuser role (created by migration 0001)
# so FORCE ROW LEVEL SECURITY is actually enforced at runtime. The backend must
# connect with this — never the postgres superuser. Dev password is a local
# placeholder; rotate and source from a secret store outside local dev.
DATABASE_URL=postgresql+asyncpg://albert_app:albert_app@postgres:5432/albert
# Admin/superuser URL used ONLY to run Alembic migrations (DDL + CREATE ROLE).
# alembic/env.py prefers this when set; the runtime app never uses it.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/albert
# Host-side dev (outside Docker) maps Postgres to localhost:5433 — override via env:
#   DATABASE_URL=postgresql+asyncpg://albert_app:albert_app@localhost:5433/albert
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/albert
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=albert

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT=secret
# Vault KV v2 path holding the runtime app-role (albert_app) DB credentials.
# Leave EMPTY for local dev → the DATABASE_URL above is used as-is. Set it in real
# deployments (e.g. database/albert_app) so the runtime DB password comes from
# Vault, not from this file. Seed with: see docs/SECRETS.md "Vault-backed DB creds".
VAULT_DB_SECRET_PATH=

JWT_SECRET=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MODELSERVER_URL=http://modelserver:8020
GUARDRAILS_URL=http://guardrails:8010
# Internal bearer credential for backend -> modelserver/guardrails calls.
# Local dev fallback only; never commit a real token.
SERVICE_AUTH_TOKEN=dev-service-token
# Vault KV v2 path holding the service auth token (e.g. service/albert).
# Leave EMPTY for local dev -> SERVICE_AUTH_TOKEN above is used as-is. Set it in
# real deployments so the backend resolves the token from Vault; the platform
# injects the same secret into the modelserver/guardrails env. Seed: see
# docs/SECRETS.md "Vault-backed service auth token".
VAULT_SERVICE_AUTH_SECRET_PATH=

# LLM provider config.
# GEMINI_MODEL is the backend agent/RAG runtime model (Owner B). It is NOT the
# Owner C classifier baseline: that baseline is recorded separately as
# gemini-2.5-flash-lite (precomputed in training artifacts + MODEL_CARD.md), is not
# read from this var, and is never called in CI.
# DEV PLACEHOLDERS (not real keys): the backend builds the Gemini LLM + embedder
# adapters at startup, which require a NON-EMPTY api key to construct. These fake
# values let the stack boot for the local demo (login, admin UI, blocked-chat
# smoke make no real LLM calls). Replace with a real key for live agent/RAG chat.
GEMINI_API_KEY=dev-local-not-a-real-key
# Live agent/RAG model. gemini-2.0-flash is deprecated for new users — use a
# current model. The real GEMINI_API_KEY belongs in Vault (secret/app/gemini_api_key);
# this .env value is a dev placeholder only.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004
GROQ_API_KEY=dev-local-not-a-real-key
GROQ_MODEL=llama-3.1-8b-instant

# OpenTelemetry + Jaeger tracing
OTEL_ENABLED=True
OTEL_SERVICE_NAME=albert-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=otlp
JAEGER_UI_BASE_URL=http://localhost:16686
JAEGER_QUERY_BASE_URL=http://localhost:16686

# Widget auth + rate limit
# Defaults are conservative dev values; tune per environment, never hard-code.
WIDGET_SESSION_TTL_SECONDS=900
WIDGET_CLOCK_SKEW_SECONDS=60
WIDGET_RATE_LIMIT_PER_IP_PER_MIN=30
WIDGET_RATE_LIMIT_PER_TENANT_PER_MIN=120
WIDGET_LOADER_URL=http://localhost:8000/widget.js